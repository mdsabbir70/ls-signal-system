# ============================================================
# LS Trading Signal System — Environment Variables
# Copy this file to .env and fill in your values
# signal.lstrading.xyz
# ============================================================

# ── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ls_trading_signals
DB_USER=ls_bot_user
DB_PASSWORD=your_strong_password_here
DB_POOL_SIZE=5

# ── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Claude AI ────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Flask API ────────────────────────────────────────────────
FLASK_SECRET_KEY=change_this_to_a_random_secret_key
FLASK_HOST=127.0.0.1
FLASK_PORT=5050
API_KEY=your_api_key_for_admin_panel

# ── Bot Settings ─────────────────────────────────────────────
# Override DB settings (DB settings take priority if set)
BOT_ACTIVE=false
TRADING_MODE=hybrid
MIN_CONFLUENCE_SCORE=80
RISK_PER_TRADE_PCT=2.0
ACCOUNT_BALANCE=1000

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ── MT5 Bridge (optional) ───────────────────────────────────
# Only needed if using MetaTrader5 Python library (Windows)
MT5_ACCOUNT=0
MT5_PASSWORD=
MT5_SERVER=
MT5_ENABLED=false
